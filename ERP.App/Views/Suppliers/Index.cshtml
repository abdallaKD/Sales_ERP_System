@model IEnumerable<ERP.Services.ViewModels.SupplierViewModel>

@{
    ViewData["Title"] = "Suppliers";

    // Extraction of parameters passed down from Controller context
    int currentPage = Convert.ToInt32(ViewData["CurrentPage"] ?? 1);
    int totalPages = Convert.ToInt32(ViewData["TotalPages"] ?? 1);
    int pageSize = Convert.ToInt32(ViewData["PageSize"] ?? 10);
    string currentFilter = ViewData["CurrentFilter"] as string;

    // Incremental index calculated against active dataset offsets
    int counter = ((currentPage - 1) * pageSize) + 1;
}

<div class="container-fluid px-4 py-3">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-truck me-2 text-primary"></i>Suppliers
            </h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Suppliers</li>
                </ol>
            </nav>
        </div>

        <div class="d-flex gap-2 flex-wrap flex-md-nowrap align-items-center">
            <form asp-action="Index" method="get" class="d-flex border rounded bg-white p-1 shadow-sm">
                <input type="text" name="searchString" value="@currentFilter" class="form-control border-0 bg-transparent form-control-sm me-2" style="min-width: 240px;" placeholder="Search name, phone, email..." />
                @if (!string.IsNullOrEmpty(currentFilter))
                {
                    <a asp-action="Index" class="btn btn-sm btn-light border-0 me-1" title="Clear Filter">
                        <i class="bi bi-x-lg text-muted"></i>
                    </a>
                }
                <button type="submit" class="btn btn-sm btn-primary px-3">
                    <i class="bi bi-search"></i>
                </button>
            </form>

            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> New Supplier
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                    <p class="mb-0">No suppliers found. @(string.IsNullOrEmpty(currentFilter) ? "" : "Try matching different keywords.")</p>
                    @if (string.IsNullOrEmpty(currentFilter))
                    {
                        <a asp-action="Create">Add a supplier now.</a>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Supplier Name</th>
                                <th>Phone Number</th>
                                <th>Email Address</th>
                                <th class="text-center">Purchases Count</th>
                                <th class="text-center">Onboarded At</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-muted">@(counter++)</td>
                                    <td class="fw-semibold">@item.Name</td>
                                    <td>@(string.IsNullOrEmpty(item.Phone) ? "—" : item.Phone)</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.Email))
                                        {
                                            <a href="mailto:@item.Email" class="text-decoration-none">@item.Email</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary rounded-pill">@item.PurchasesCount</span>
                                    </td>
                                    <td class="text-center text-muted" title="@item.CreatedAt.ToString("f")">
                                        @item.CreatedAt.ToString("yyyy-MM-dd")
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary me-1" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete"
                                                data-bs-toggle="modal"
                                                data-bs-target="#deleteModal"
                                                data-id="@item.Id"
                                                data-name="@item.Name">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center py-3">
                        <div class="text-muted small">
                            Showing page <strong>@currentPage</strong> of @totalPages
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-pageNumber="@(currentPage - 1)"
                                       asp-route-searchString="@currentFilter">Previous</a>
                                </li>

                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link" asp-action="Index"
                                           asp-route-pageNumber="@i"
                                           asp-route-searchString="@currentFilter">@i</a>
                                    </li>
                                }

                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-pageNumber="@(currentPage + 1)"
                                       asp-route-searchString="@currentFilter">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger fw-bold" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                Are you sure you want to delete supplier <strong id="supplierNameLabel"></strong>?
                This structural data alteration cannot be undone.
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('deleteId').value = button.dataset.id;
            document.getElementById('supplierNameLabel').textContent = button.dataset.name;
        });
    </script>
}