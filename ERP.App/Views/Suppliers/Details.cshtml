@using ERP.Domain.Enums
@model ERP.Services.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container py-4">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-info-circle-fill me-2 text-primary"></i>Supplier Details
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Suppliers</a></li>
                <li class="breadcrumb-item active">Details</li>
            </ol>
        </nav>
    </div>

    <div class="row g-4">

        <!-- Info Card -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-building me-2 text-primary"></i>@Model.Name
                    </h5>
                </div>
                <div class="card-body px-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted fw-semibold">ID</dt>
                        <dd class="col-sm-7">@Model.Id</dd>

                        <dt class="col-sm-5 text-muted fw-semibold">Phone</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrEmpty(Model.Phone))
                            {
                                <a href="tel:@Model.Phone" class="text-decoration-none">
                                    <i class="bi bi-telephone me-1"></i>@Model.Phone
                                </a>
                            }
                            else
                            {

                                <span class="text-muted">—</span>
                            }
                        </dd>

                        <dt class="col-sm-5 text-muted fw-semibold">Email</dt>
                        <dd class="col-sm-7">
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <a href="mailto:@Model.Email" class="text-decoration-none">
                                    <i class="bi bi-envelope me-1"></i>@Model.Email
                                </a>
                            }
                            else
                            {

                                <span class="text-muted">—</span>
                            }
                        </dd>

                        <dt class="col-sm-5 text-muted fw-semibold">Address</dt>
                        <dd class="col-sm-7">
                            @(string.IsNullOrEmpty(Model.Address) ? "—" : Model.Address)
                        </dd>

                        <dt class="col-sm-5 text-muted fw-semibold">Purchases</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-primary rounded-pill">@Model.PurchasesCount</span>
                        </dd>

                        <dt class="col-sm-5 text-muted fw-semibold">Created</dt>
                        <dd class="col-sm-7 small text-muted">
                            @Model.CreatedAt.ToString("dd MMM yyyy")
                        </dd>
                    </dl>
                </div>
                <div class="card-footer bg-transparent border-0 px-4 pb-4 d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                </div>
            </div>
        </div>

        <!-- Purchases Card -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-cart3 me-2 text-primary"></i>Purchase History
                    </h5>
                    <span class="badge bg-primary rounded-pill">@Model.PurchasesCount</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Purchases == null || !Model.Purchases.Any())
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-bag-x fs-2 d-block mb-2"></i>
                            <small>No purchases recorded yet.</small>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Date</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var purchase in Model.Purchases)
                                    {
                                        <tr>
                                            <td class="text-muted small">@purchase.Id</td>
                                            <td class="small">@purchase.CreatedAt.ToString("dd MMM yyyy")</td>
                                            <td class="text-end fw-semibold">
                                                @purchase.TotalAmount.ToString("C")
                                            </td>
                                            <td class="text-center">
                                                <span class="badge @(purchase.Status == PurchaseStatus.Received ? "bg-success" : purchase.Status == PurchaseStatus.Pending ? "bg-warning text-dark" : "bg-secondary")">
                                                    @purchase.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

