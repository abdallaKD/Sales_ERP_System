@model IEnumerable<ERP.Services.ViewModels.InventoryLogVM.DisplayAllLogsViewModel>
@using ERP.Domain.Enums

@{
    ViewData["Title"] = "Inventory Logs";

    // Extract pagination metadata from ViewData
    int currentPage = Convert.ToInt32(ViewData["CurrentPage"] ?? 1);
    int totalPages = Convert.ToInt32(ViewData["TotalPages"] ?? 1);
    int pageSize = Convert.ToInt32(ViewData["PageSize"] ?? 10);

    // Calculate row continuous row counter across different pages
    int counter = ((currentPage - 1) * pageSize) + 1;
}

<div class="container-fluid px-4 py-3">
    <h2 class="mb-4">Inventory Logs</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No inventory logs found.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body border-bottom">
                <div class="row g-2 align-items-center">
                    <div class="col-md-4">
                        <input type="text" id="search" class="form-control form-control-sm"
                               placeholder="Search product or user…" oninput="applyFilters()">
                    </div>
                    <div class="col-auto">
                        <select id="typeFilter" class="form-select form-select-sm" onchange="applyFilters()">
                            <option value="">All types</option>
                            <option value="In">In</option>
                            <option value="Out">Out</option>
                            <option value="Adjustment">Adjustment</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <select id="sourceFilter" class="form-select form-select-sm" onchange="applyFilters()">
                            <option value="">All sources</option>
                            <option value="order">Order</option>
                            <option value="purchase">Purchase</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-outline-secondary" onclick="clearFilters()">
                            <i class="bi bi-x"></i> Clear
                        </button>
                    </div>
                    <div class="col-auto ms-auto">
                        <small class="text-muted" id="rowCount"></small>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0" id="logsTable">
                    <thead class="table-dark">
                        <tr>
                            <th style="cursor:pointer" onclick="sortTable('id')"># <span id="sort-id">↕</span></th>
                            <th style="cursor:pointer" onclick="sortTable('product')">Product <span id="sort-product">↕</span></th>
                            <th style="cursor:pointer" onclick="sortTable('qty')">Quantity <span id="sort-qty">↕</span></th>
                            <th style="cursor:pointer" onclick="sortTable('type')">Type <span id="sort-type">↕</span></th>
                            <th>Order</th>
                            <th>Purchase</th>
                            <th style="cursor:pointer" onclick="sortTable('user')">Recorded By <span id="sort-user">↕</span></th>
                            <th style="cursor:pointer" onclick="sortTable('date')">Created At <span id="sort-date">↕</span></th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tbody"></tbody>
                </table>
                <div id="noResults" class="text-center text-muted py-4" style="display:none">
                    No logs match your filters.
                </div>
            </div>



            @if (totalPages > 1)
            {
                <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center py-3">
                    <div class="text-muted small">
                        Showing page <strong>@currentPage</strong> of @totalPages
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-item" asp-action="Index"
                                   asp-route-pageNumber="@(currentPage - 1)"
                                   class="page-link">Previous</a>
                            </li>

                            @for (int j = 1; j <= totalPages; j++)
                            {
                                <li class="page-item @(j == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-pageNumber="@j">@j</a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@(currentPage + 1)">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }


        </div>
    }
</div>


@section Scripts {
    <script>

        const startRow = @(((currentPage - 1) * pageSize) + 1);
        const logs = [
            @foreach (var log in Model)
            {
                    @:{id:@log.Id, product:"@log.ProductName", qty:@log.Quantity, type:"@log.Type.ToString()", orderId:@(log.OrderId.HasValue? log.OrderId.ToString() : "null"), purchaseId:@(log.PurchaseId.HasValue? log.PurchaseId.ToString() : "null"), user:"@log.UserName", date:"@log.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")"},
            }
        ];

        let sortCol = 'date', sortDir = -1;
        let filtered = [...logs];

        function badgeHtml(type) {
            const map = {
                'In':         ['bg-success', 'In'],
                'Out':        ['bg-danger',  'Out'],
                'Adjustment': ['bg-warning text-dark', 'Adjustment']
            };
            const [cls, label] = map[type] || ['bg-secondary', type];
            return `<span class="badge ${cls}">${label}</span>`;
        }

        function qtyHtml(q) {
            return q < 0
                ? `<span class="text-danger fw-semibold">${q}</span>`
                : `<span class="text-success fw-semibold">+${q}</span>`;
        }

        function fmtDate(d) {
            const dt = new Date(d);
            return dt.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' })
                 + ' ' + dt.toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit' });
        }

        function render() {
            const tbody    = document.getElementById('tbody');
            const noRes    = document.getElementById('noResults');
            const rowCount = document.getElementById('rowCount');
            rowCount.textContent = `${filtered.length} of ${logs.length} entries`;

            if (!filtered.length) {
                tbody.innerHTML = '';
                noRes.style.display = 'block';
                return;
            }
            noRes.style.display = 'none';
            tbody.innerHTML = filtered.map((l, i) => `
                <tr>
                    <td class="text-muted">#${startRow + i}</td>
                    <td>${l.product}</td>
                    <td>${qtyHtml(l.qty)}</td>
                    <td>${badgeHtml(l.type)}</td>
                    <td>${l.orderId    ? `<span class="text-primary">#${l.orderId}</span>`    : '<span class="text-muted">—</span>'}</td>
                    <td>${l.purchaseId ? `<span class="text-primary">#${l.purchaseId}</span>` : '<span class="text-muted">—</span>'}</td>
                    <td>${l.user}</td>
                    <td class="text-muted">${fmtDate(l.date)}</td>
                    <td>
                        <a href="/InventoryLog/Details/${l.id}" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye"></i> Details
                        </a>
                    </td>
                </tr>`).join('');
        }

        function applyFilters() {
            const q      = document.getElementById('search').value.toLowerCase();
            const type   = document.getElementById('typeFilter').value;
            const source = document.getElementById('sourceFilter').value;

            filtered = logs.filter(l => {
                const matchQ      = !q      || l.product.toLowerCase().includes(q) || l.user.toLowerCase().includes(q);
                const matchType   = !type   || l.type === type;
                const matchSource = !source || (source === 'order' && l.orderId) || (source === 'purchase' && l.purchaseId);
                return matchQ && matchType && matchSource;
            });
            doSort();
        }

        function clearFilters() {
            document.getElementById('search').value = '';
            document.getElementById('typeFilter').value  = '';
            document.getElementById('sourceFilter').value = '';
            filtered = [...logs];
            doSort();
        }

        function sortTable(col) {
            if (sortCol === col) sortDir *= -1;
            else { sortCol = col; sortDir = 1; }
            document.querySelectorAll('[id^="sort-"]').forEach(el => el.textContent = '↕');
            const icon = document.getElementById('sort-' + col);
            if (icon) icon.textContent = sortDir === 1 ? '↑' : '↓';
            doSort();
        }

        function doSort() {
            const key = { id:'id', product:'product', qty:'qty', type:'type', user:'user', date:'date' }[sortCol] || 'date';
            filtered.sort((a, b) => {
                let av = a[key], bv = b[key];
                return typeof av === 'string' ? av.localeCompare(bv) * sortDir : (av - bv) * sortDir;
            });
            render();
        }

        sortTable('date');
    </script>
}