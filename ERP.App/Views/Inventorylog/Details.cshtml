@model ERP.Services.ViewModels.InventoryLogVM.DisplayAllLogsViewModel
@using ERP.Domain.Enums

@{
    ViewData["Title"] = "Log Details";

    var (badgeClass, badgeLabel) = Model.Type switch
    {
        InventoryMovementType.In => ("bg-success", "In"),
        InventoryMovementType.Out => ("bg-danger", "Out"),
        InventoryMovementType.Adjustment => ("bg-warning text-dark", "Adjustment"),
        _ => ("bg-secondary", Model.Type.ToString())
    };
}

<div class="container py-4" style="max-width: 700px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Inventory Log <span class="text-muted fs-5">#@Model.Id</span></h2>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Back to Logs
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Log Summary</span>
            <span class="badge @badgeClass fs-6">@badgeLabel</span>
        </div>

        <div class="card-body">
            <dl class="row mb-0">

                <dt class="col-sm-4 text-muted">Log ID</dt>
                <dd class="col-sm-8">#@Model.Id</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(m => m.ProductName)</dt>
                <dd class="col-sm-8">@Model.ProductName</dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(m => m.Quantity)</dt>
                <dd class="col-sm-8">
                    @if (Model.Quantity < 0)
                    {
                        <span class="text-danger fw-semibold">@Model.Quantity units</span>
                    }
                    else
                    {
                        <span class="text-success fw-semibold">+@Model.Quantity units</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(m => m.Type)</dt>
                <dd class="col-sm-8">
                    <span class="badge @badgeClass">@badgeLabel</span>
                </dd>

                <dt class="col-sm-4 text-muted">Order</dt>
                <dd class="col-sm-8">
                    @if (Model.OrderId.HasValue)
                    {
                        <span class="text-primary">#@Model.OrderId</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted">Purchase</dt>
                <dd class="col-sm-8">
                    @if (Model.PurchaseId.HasValue)
                    {
                        <span class="text-primary">#@Model.PurchaseId</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </dd>

                <dt class="col-sm-4 text-muted">@Html.DisplayNameFor(m => m.UserName)</dt>
                <dd class="col-sm-8">
                    <i class="bi bi-person-circle me-1"></i>@Model.UserName
                </dd>

                <dt class="col-sm-4 text-muted">Created At</dt>
                <dd class="col-sm-8">
                    <i class="bi bi-clock me-1"></i>@Model.CreatedAt.ToString("MMMM dd, yyyy — hh:mm tt")
                </dd>

            </dl>
        </div>
    </div>
</div>