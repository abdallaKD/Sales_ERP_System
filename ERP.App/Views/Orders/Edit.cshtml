@model OrderDetailsViewModel

@{
    ViewData["Title"] = $"Edit Order #{Model.OrderId}";
}

<div class="container py-4" style="max-width: 900px;">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-pencil-fill me-2 text-primary"></i>Edit Order #@Model.OrderId
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Order" asp-action="Index">Orders</a></li>
                <li class="breadcrumb-item active">Edit</li>
            </ol>
        </nav>
    </div>

    <!-- Error Alert -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Main Form Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.OrderId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="OrderId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <!-- Order Info Section -->
                <h4 class="fw-bold text-dark mb-3">
                    <i class="bi bi-info-circle me-2 text-primary"></i>Order Information
                </h4>

                <div class="mb-4">
                    <label asp-for="CustomerId" class="form-label fw-semibold">Customer</label>
                    <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select">
                        <option value="">-- Select customer --</option>
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <!-- Order Items Section -->
                <h4 class="fw-bold text-dark mb-3">
                    <i class="bi bi-box-seam me-2 text-primary"></i>Order Items
                </h4>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-center" style="width: 150px">Quantity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Items.Count; i++)
                                    {
                                        var currentProductId = Model.Items[i].ProductId;
                                        var currentQty = Model.Items[i].Quantity;

                                        <tr>
                                            <td>
                                                <select name="Items[@i].ProductId" class="form-select">
                                                    <option value="">-- Select product --</option>
                                                    @foreach (var p in Model.Products)
                                                    {
                                                        if (p.Value == currentProductId.ToString())
                                                        {
                                                            <option value="@p.Value" selected>@p.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@p.Value">@p.Text</option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                            <td class="text-center">
                                                <input type="number" name="Items[@i].Quantity"
                                                       class="form-control text-center" value="@currentQty" min="1" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                }</pre
                        </div>
                    </div>
                </div>

                <small class="text-muted mt-2 d-block">Leave unused rows blank — they will be ignored.</small>

                <!-- Action Buttons -->
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Update Order
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i>Back to Orders
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}