@model OrderDetailsViewModel

@{
    ViewData["Title"] = "New Order";
}

<div class="container py-4">

    <!-- Header with breadcrumb -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-plus-circle me-2 text-primary"></i>New Order
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Order" asp-action="Index">Orders</a></li>
                <li class="breadcrumb-item active">Create</li>
            </ol>
        </nav>
    </div>

    <!-- Validation Summary -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Please correct the following errors:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Main Form Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post" id="main-form">
                @Html.AntiForgeryToken()

                <!-- Order Info Section -->
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-info-circle me-2 text-primary"></i>Order Information
                </h5>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Customer</label>
                    <select name="CustomerId" class="form-select">
                        <option value="">-- Select customer --</option>
                        @foreach (var c in Model.Customers!)
                        {
                            if (c.Value == Model.CustomerId.ToString())
                            {
                                <option value="@c.Value" selected>@c.Text</option>
                            }
                            else
                            {
                                <option value="@c.Value">@c.Text</option>
                            }
                        }
                    </select>
                </div>

                <hr class="my-4" />

                <!-- Items Section -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-box-seam me-2 text-primary"></i>Order Items
                    </h5>
                    <button type="submit" asp-action="AddRow" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-lg me-1"></i>Add Product
                    </button>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 60px" class="text-center">#</th>
                                        <th>Product</th>
                                        <th style="width: 150px" class="text-center">Quantity</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Items.Count; i++)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <button type="submit" asp-action="RemoveRow"
                                                        asp-route-rowIndex="@i"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Remove item">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                            <td>
                                                <select name="Items[@i].ProductId" class="form-select">
                                                    <option value="">-- Select product --</option>
                                                    @foreach (var p in Model.Products!)
                                                    {
                                                        if (p.Value == Model.Items[i].ProductId.ToString())
                                                        {
                                                            <option value="@p.Value" selected>@p.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@p.Value">@p.Text</option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                            <td class="text-center">
                                                <input type="number" name="Items[@i].Quantity"
                                                       class="form-control text-center"
                                                       value="@Model.Items[i].Quantity" min="1" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <small class="text-muted mt-2 d-block">Leave unused rows blank — they will be ignored.</small>

                <!-- Action Buttons -->
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Save Order
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i>Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>