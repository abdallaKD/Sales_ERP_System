@model OrderDetailsViewModel
@{
    ViewData["Title"] = "New Order";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">New Order</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<form asp-action="Create" method="post" id="main-form">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header">Order Info</div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Customer</label>
                <select name="CustomerId" class="form-select">
                    <option value="0">-- Select customer --</option>
                    @foreach (var c in Model.Customers!)
                    {
                        if (c.Value == Model.CustomerId.ToString())
                        {
                            <option value="@c.Value" selected>@c.Text</option>
                        }
                        else
                        {
                            <option value="@c.Value">@c.Text</option>
                        }
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Items</span>
            <button type="submit" asp-action="AddRow" class="btn btn-sm btn-outline-primary">
                + Add Product
            </button>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th style="width:130px">Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Items.Count; i++)
                    {
                        <tr>
                            <td>
                                <button type="submit" asp-action="RemoveRow"
                                        asp-route-rowIndex="@i"
                                        class="btn btn-sm btn-outline-danger">
                                    &times;
                                </button>
                            </td>

                            <td>
                                <select name="Items[@i].ProductId" class="form-select">
                                    <option value="0">-- Select product --</option>
                                    @foreach (var p in Model.Products!)
                                    {
                                        if (p.Value == Model.Items[i].ProductId.ToString())
                                        {
                                            <option value="@p.Value" selected>@p.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@p.Value">@p.Text</option>
                                        }
                                    }
                                </select>
                            </td>
                            <td>
                                <input type="number" name="Items[@i].Quantity"
                                       class="form-control"
                                       value="@Model.Items[i].Quantity" min="1" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <small class="text-muted">Leave unused rows blank — they will be ignored.</small>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Order</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>