@model IEnumerable<OrderViewModel>
@using ERP.Domain.Enums
@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Orders</h4>
    <a asp-action="Create" class="btn btn-primary">New Order</a>
</div>

@if (TempData["Success"] != null)
{
        <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
        <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Customer</th>
            <th>Date</th>
            <th>Status</th>
            <th>Total</th>
            <th>Paid</th>
            <th>Remaining</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
                <tr>
                    <td>@o.Id</td>
                    <td>@o.CustomerName</td>
                    <td>@o.OrderDate.ToString("dd MMM yyyy")</td>
                    <td>
                    @if (o.Status == OrderStatus.Pending)
                    {
                                <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (o.Status == OrderStatus.Completed)
                    {
                                <span class="badge bg-success">Completed</span>
                    }
                    else if (o.Status == OrderStatus.Cancelled)
                    {
                                <span class="badge bg-danger">Cancelled</span>
                    }
                    </td>
                    <td>@o.TotalAmount.ToString("C")</td>
                    <td>@o.PaidAmount.ToString("C")</td>
                    <td>@o.RemainingAmount.ToString("C")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@o.Id"
                           class="btn btn-sm btn-outline-secondary">Details</a>

                    @if (o.Status == OrderStatus.Pending)
                    {
                                <a asp-action="Edit" asp-route-id="@o.Id"
                                   class="btn btn-sm btn-outline-primary">Edit</a>
                                
                                   <a asp-controller="Payment"
                                   asp-action="OrderPayments"
                                   asp-route-orderId="@o.Id"
                                   class="btn btn-sm btn-outline-success">Payments</a>

                                <form asp-action="Cancel" asp-route-id="@o.Id"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Cancel this order?')">
                            @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Cancel
                                    </button>
                                </form>
                    }
                    </td>
                </tr>
        }
    </tbody>
</table>