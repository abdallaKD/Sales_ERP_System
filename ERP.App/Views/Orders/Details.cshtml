@model OrderDetailsViewModel
@using ERP.Domain.Enums
@{
    ViewData["Title"] = $"Order #{Model.OrderId}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Order #@Model.OrderId</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@Model.CustomerName</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">@Model.OrderDate.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Total</dt>
            <dd class="col-sm-9">@Model.TotalAmount.ToString("C")</dd>

            <dt class="col-sm-3">Paid</dt>
            <dd class="col-sm-9">@Model.PaidAmount.ToString("C")</dd>

            <dt class="col-sm-3">Remaining</dt>
            <dd class="col-sm-9">@Model.RemainingAmount.ToString("C")</dd>
        </dl>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">Items</div>
    <div class="card-body p-0">
        <table class="table mb-0">
            <thead class="table-light">
                <tr>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.ToString("C")</td>
                        <td>@item.TotalPrice.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-semibold table-light">
                    <td colspan="3" class="text-end">Grand Total</td>
                    <td>@Model.TotalAmount.ToString("C")</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@if (Model.Status == OrderStatus.Pending)
{
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OrderId"
           class="btn btn-primary">Edit</a>

        <form asp-action="Cancel" asp-route-id="@Model.OrderId"
              method="post"
              onsubmit="return confirm('Cancel this order?')">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">Cancel Order</button>
        </form>
    </div>
}