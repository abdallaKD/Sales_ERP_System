@model ERP.Services.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Category Details";
}

<div class="container py-4" ">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-info-circle-fill me-2 text-primary"></i>Category Details
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Categories</a></li>
                <li class="breadcrumb-item active">Details</li>
            </ol>
        </nav>
    </div>

    <!-- Details Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <dl class="row mb-0">
                <dt class="col-sm-4 text-muted fw-semibold">ID</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4 text-muted fw-semibold">Name</dt>
                <dd class="col-sm-8 fw-bold">@Model.Name</dd>

                <dt class="col-sm-4 text-muted fw-semibold">Description</dt>
                <dd class="col-sm-8">
                    @(string.IsNullOrEmpty(Model.Description) ? "—" : Model.Description)
                </dd>

                <dt class="col-sm-4 text-muted fw-semibold">Products</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-primary rounded-pill">@Model.ProductsCount</span>
                </dd>
            </dl>

        </div>

        <!-- products of category-->
        <h4 class="mt-4 mb-3 fw-bold text-dark">
            <i class="bi bi-box-seam me-2 text-primary"></i>Products List
        </h4>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                @if (Model.Products == null || !Model.Products.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                        <p class="mb-0">No products found in this category.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Product</th>
                                    <th>SKU</th>
                                    <th>Stock</th>
                                    <th>Cost Price</th>
                                    <th>Selling Price</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model.Products)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(product.Image))
                                                {
                                                    <img src="~/images/products/@product.Image" alt="@product.Name"
                                                         class="rounded me-3" style="width: 45px; height: 45px; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="bg-light rounded me-3 d-flex align-items-center justify-content-center"
                                                         style="width: 45px; height: 45px;">
                                                        <i class="bi bi-image text-muted"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <div class="fw-bold text-dark">@product.Name</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td><code class="text-primary fw-medium">@product.SKU</code></td>
                                        <td>
                                            @if (product.StockQuantity > 10)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">@product.StockQuantity In Stock</span>
                                            }
                                            else if (product.StockQuantity > 0)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle">@product.StockQuantity Low Stock</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Out of Stock</span>
                                            }
                                        </td>
                                        <td class="text-muted">@product.CostPrice.ToString("N2")</td>
                                        <td class="fw-bold text-primary">@product.SellingPrice.ToString("N2")</td>
                                        <td class="text-center">
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id"
                                               class="btn btn-sm btn-outline-secondary" title="View Details">
                                                <i class="bi bi-eye-fill"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>


        <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0 d-flex gap-2 mt-4">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>
</div>


