@using ERP.Domain.Models
@using ERP.Domain.Enums

@model IEnumerable<Purchase>
@{
    ViewData["Title"] = "Purchases";
    int i = 1;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap');

    :root {
        --bg-page: #f0f2f7;
        --bg-card: #ffffff;
        --border: #e2e6f0;
        --text-primary: #1a1e2e;
        --text-muted: #6b7394;
        --accent: #3d5cff;
        --accent-light: #eef0ff;
        --danger: #ff3d5c;
        --success: #00b87a;
        --warning: #ff8c00;
        --radius: 10px;
        --shadow: 0 2px 12px rgba(61,92,255,.07);
        --sans: 'DM Sans', sans-serif;
    }

    body { font-family: var(--sans); background: var(--bg-page); }

    .purchases-page { padding: 2rem 1.5rem 3rem; }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.75rem;
    }

    .page-header__title { font-size: 1.65rem; font-weight: 600; color: var(--text-primary); margin: 0; }
    .page-header__sub { font-size: .85rem; color: var(--text-muted); margin: .15rem 0 0; }

    .card-shell {
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .table { margin: 0; }
    .table thead th { background: #f7f8fc; color: var(--text-muted); font-size: .78rem; text-transform: uppercase; letter-spacing: .5px; border-bottom: 1px solid var(--border); padding: .85rem 1rem; }
    .table tbody td { padding: .85rem 1rem; vertical-align: middle; border-bottom: 1px solid var(--border); font-size: .9rem; color: var(--text-primary); }

    .status-badge { display: inline-block; padding: .25rem .75rem; border-radius: 20px; font-size: .78rem; font-weight: 500; }
    .status-pending  { background: #fff5e6; color: #ff8c00; }
    .status-received { background: #e6faf4; color: #00b87a; }
    .status-cancelled{ background: #fff0f2; color: #ff3d5c; }

    .btn-add { background: var(--accent); color: #fff; border: none; border-radius: var(--radius); padding: .6rem 1.25rem; font-weight: 500; text-decoration: none; }
    .btn-add:hover { background: #2a44e0; color: #fff; }

    .action-btns { display: flex; gap: .4rem; }
</style>

<div class="purchases-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="page-header">
        <div>
            <h1 class="page-header__title">Purchases</h1>
            <p class="page-header__sub">Manage all purchase orders</p>
        </div>
        <a asp-action="Create" class="btn-add"><i class="bi bi-plus-lg me-1"></i> New Purchase</a>
    </div>

    <div class="card-shell">
        <table class="table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Purchase Date</th>
                    <th>Supplier</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    string statusClass = item.Status switch
                    {
                        PurchaseStatus.Pending => "status-pending",
                        PurchaseStatus.Received => "status-received",
                        PurchaseStatus.Cancelled => "status-cancelled",
                        _ => ""
                    };

                    <tr>
                        <td>@i</td>
                        <td>@item.PurchaseDate.ToString("MMM dd, yyyy")</td>
                        <td>@item.Supplier?.Name</td>
                        <td>@item.TotalAmount.ToString("C")</td>
                        <td><span class="status-badge @statusClass">@item.Status</span></td>
                        <td>@item.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <div class="action-btns">
                                <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-secondary" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        title="Delete"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-id="@item.Id"
                                        data-name="Purchase #@item.Id">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    i++;
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-danger fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                Are you sure you want to delete <strong id="purchaseNameLabel"></strong>?
                <br><small class="text-muted">This action cannot be undone.</small>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('deleteId').value = btn.dataset.id;
            document.getElementById('purchaseNameLabel').textContent = btn.dataset.name;
        });
    </script>
}
