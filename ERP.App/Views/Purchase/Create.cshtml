@using ERP.Services.ViewModels
@using ERP.Domain.Models

@model PurchaseViewModel
@{
    ViewData["Title"] = "New Purchase";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap');

    :root {
        --bg-page: #f0f2f7;
        --bg-card: #ffffff;
        --border: #e2e6f0;
        --text-primary: #1a1e2e;
        --text-muted: #6b7394;
        --accent: #3d5cff;
        --radius: 10px;
        --shadow: 0 2px 12px rgba(61,92,255,.07);
        --sans: 'DM Sans', sans-serif;
    }

    body { font-family: var(--sans); background: var(--bg-page); }
    .create-page { padding: 2rem 1.5rem 3rem; max-width: 900px; margin: auto; }
    .card-shell { background: var(--bg-card); border-radius: var(--radius); box-shadow: var(--shadow); padding: 2rem; margin-bottom: 1.5rem; }
    .section-title { font-size: 1rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: .5rem; }
    .back-btn { color: var(--text-muted); text-decoration: none; font-size: .9rem; display: inline-flex; align-items: center; gap: .4rem; margin-bottom: 1.25rem; }
    .back-btn:hover { color: var(--accent); }
    .btn-add-item { border: 2px dashed var(--border); background: none; color: var(--accent); border-radius: var(--radius); padding: .5rem 1rem; width: 100%; margin-top: .5rem; cursor: pointer; }
    .btn-add-item:hover { background: #eef0ff; }
    .item-row { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: .75rem; align-items: end; margin-bottom: .75rem; }
    .remove-btn { background: none; border: none; color: #ff3d5c; font-size: 1.2rem; cursor: pointer; padding-bottom: .3rem; }
</style>

<div class="create-page">

    <a asp-action="Index" class="back-btn"><i class="bi bi-arrow-left"></i> Back to Purchases</a>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="card-shell">
            <div class="section-title">Purchase Information</div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Supplier</label>
                    <select name="SupplierId" class="form-select" required>
                        <option value="">-- Select Supplier --</option>
                        @foreach (var supplier in Model.Suppliers)
                        {
                            <option value="@supplier.Id">@supplier.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Purchase Date</label>
                    <input type="datetime-local" name="PurchaseDate" class="form-control"
                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>
            </div>
        </div>

        <div class="card-shell">
            <div class="section-title">Purchase Items</div>

            <div id="itemsContainer">
                <div class="item-row">
                    <div>
                        <label class="form-label">Product</label>
                        <select name="PurchaseItems[0].ProductId" class="form-select" required>
                            <option value="">-- Select Product --</option>
                            @foreach (var product in Model.Products)
                            {
                                <option value="@product.Id">@product.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="form-label">Quantity</label>
                        <input type="number" name="PurchaseItems[0].Quantity" class="form-control" min="1" value="1" required />
                    </div>
                    <div>
                        <label class="form-label">Unit Cost</label>
                        <input type="number" name="PurchaseItems[0].UnitCost" class="form-control" min="0" step="0.01" required />
                    </div>
                    <div>
                        <button type="button" class="remove-btn" onclick="removeItem(this)">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    </div>
                </div>
            </div>

            <button type="button" class="btn-add-item" onclick="addItem()">
                <i class="bi bi-plus-lg me-1"></i> Add Another Item
            </button>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-lg me-1"></i> Create Purchase
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        let itemIndex = 1;

        const productOptions = `@foreach (var product in Model.Products) {
            <text><option value="@product.Id">@product.Name</option></text>
        }`;

        function addItem() {
            const container = document.getElementById('itemsContainer');
            const div = document.createElement('div');
            div.className = 'item-row';
            div.innerHTML = `
                <div>
                    <label class="form-label">Product</label>
                    <select name="PurchaseItems[${itemIndex}].ProductId" class="form-select" required>
                        <option value="">-- Select Product --</option>
                        ${productOptions}
                    </select>
                </div>
                <div>
                    <label class="form-label">Quantity</label>
                    <input type="number" name="PurchaseItems[${itemIndex}].Quantity" class="form-control" min="1" value="1" required />
                </div>
                <div>
                    <label class="form-label">Unit Cost</label>
                    <input type="number" name="PurchaseItems[${itemIndex}].UnitCost" class="form-control" min="0" step="0.01" required />
                </div>
                <div>
                    <button type="button" class="remove-btn" onclick="removeItem(this)">
                        <i class="bi bi-x-circle"></i>
                    </button>
                </div>
            `;
            container.appendChild(div);
            itemIndex++;
        }

        function removeItem(btn) {
            const row = btn.closest('.item-row');
            const allRows = document.querySelectorAll('.item-row');
            if (allRows.length > 1) {
                row.remove();
            }
        }
    </script>
}