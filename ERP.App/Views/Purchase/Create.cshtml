@using ERP.Services.ViewModels
@using ERP.Domain.Models
@model PurchaseViewModel
@{
    ViewData["Title"] = "New Purchase";
}

<div class="container-fluid px-4 py-3">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="mb-1 fw-bold text-dark">
            <i class="bi bi-plus-circle me-2 text-primary"></i>New Purchase
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Purchases</a></li>
                <li class="breadcrumb-item active">Create</li>
            </ol>
        </nav>
    </div>

    <!-- Validation Summary -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Please correct the following errors:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <!-- Purchase Info -->
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-info-circle me-2 text-primary"></i>Purchase Information
                </h5>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Supplier</label>
                        <select name="SupplierId" class="form-select" required>
                            <option value="">-- Select Supplier --</option>
                            @foreach (var supplier in Model.Suppliers)
                            {
                                <option value="@supplier.Id">@supplier.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Purchase Date</label>
                        <input type="datetime-local" name="PurchaseDate" class="form-control"
                               value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Items -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-box-seam me-2 text-primary"></i>Purchase Items
                    </h5>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="itemsTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th style="width:150px" class="text-center">Quantity</th>
                                        <th style="width:180px" class="text-center">Unit Cost</th>
                                        <th style="width:60px" class="text-center"></th>
                                    </tr>
                                </thead>
                                <tbody id="itemsContainer">
                                    <tr>
                                        <td>
                                            <select name="PurchaseItems[0].ProductId" class="form-select" required>
                                                <option value="">-- Select Product --</option>
                                                @foreach (var product in Model.Products)
                                                {
                                                    <option value="@product.Id">@product.Name</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <input type="number" name="PurchaseItems[0].Quantity"
                                                   class="form-control text-center" min="1" value="1" required />
                                        </td>
                                        <td>
                                            <input type="number" name="PurchaseItems[0].UnitCost"
                                                   class="form-control text-center" min="0" step="0.01" required />
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="removeItem(this)" title="Remove">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <button type="button" class="btn btn-outline-primary btn-sm mt-3" onclick="addItem()">
                    <i class="bi bi-plus-lg me-1"></i> Add Another Item
                </button>

                <small class="text-muted d-block mt-2">Leave unused rows blank — they will be ignored.</small>

                <hr class="my-4" />

                <!-- Actions -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i> Create Purchase
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let itemIndex = 1;

        const productOptions = `@foreach (var product in Model.Products) {
            <text><option value="@product.Id">@product.Name</option></text>
    }
`;

    function addItem() {
        const tbody = document.getElementById('itemsContainer');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td>
                <select name="PurchaseItems[${itemIndex}].ProductId" class="form-select" required>
                    <option value="">-- Select Product --</option>
                    ${productOptions}
                </select>
            </td>
            <td>
                <input type="number" name="PurchaseItems[${itemIndex}].Quantity"
                       class="form-control text-center" min="1" value="1" required />
            </td>
            <td>
                <input type="number" name="PurchaseItems[${itemIndex}].UnitCost"
                       class="form-control text-center" min="0" step="0.01" required />
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger"
                        onclick="removeItem(this)" title="Remove">
                    <i class="bi bi-trash"></i>
                </button>
            </td>
        `;
        tbody.appendChild(tr);
        itemIndex++;
    }

    function removeItem(btn) {
        const allRows = document.querySelectorAll('#itemsContainer tr');
        if (allRows.length > 1)
            btn.closest('tr').remove();
    }
</script>
}