@using ERP.Services.ViewModels
@using ERP.Domain.Enums

@model PurchaseViewModel
@{
    ViewData["Title"] = "Edit Purchase";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap');

    :root {
        --bg-page: #f0f2f7;
        --bg-card: #ffffff;
        --border: #e2e6f0;
        --text-primary: #1a1e2e;
        --text-muted: #6b7394;
        --accent: #3d5cff;
        --radius: 10px;
        --shadow: 0 2px 12px rgba(61,92,255,.07);
        --sans: 'DM Sans', sans-serif;
    }

    body { font-family: var(--sans); background: var(--bg-page); }
    .edit-page { padding: 2rem 1.5rem 3rem; max-width: 900px; margin: auto; }
    .card-shell { background: var(--bg-card); border-radius: var(--radius); box-shadow: var(--shadow); padding: 2rem; margin-bottom: 1.5rem; }
    .section-title { font-size: 1rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 1rem; border-bottom: 1px solid var(--border); padding-bottom: .5rem; }
    .back-btn { color: var(--text-muted); text-decoration: none; font-size: .9rem; display: inline-flex; align-items: center; gap: .4rem; margin-bottom: 1.25rem; }
    .back-btn:hover { color: var(--accent); }
</style>

<div class="edit-page">

    <a asp-action="Index" class="back-btn"><i class="bi bi-arrow-left"></i> Back to Purchases</a>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <div class="card-shell">
            <div class="section-title">Edit Purchase #@Model.Id</div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Supplier</label>
                    <select name="SupplierId" class="form-select" required>
                        <option value="">-- Select Supplier --</option>
                        @foreach (var supplier in Model.Suppliers)
                        {
                            if (supplier.Name == Model.SupplierName)
                            {
                                <option value="@supplier.Id" selected>@supplier.Name</option>
                            }
                            else
                            {
                                <option value="@supplier.Id">@supplier.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Purchase Date</label>
                    <input type="datetime-local" name="PurchaseDate" class="form-control"
                           value="@Model.PurchaseDate.ToString("yyyy-MM-ddTHH:mm")" required />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Status</label>
                    <select name="Status" class="form-select" required>
                        @foreach (var status in Enum.GetValues<PurchaseStatus>())
                        {
                            if (status.ToString() == Model.Status)
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Total Amount</label>
                    <input type="number" name="TotalAmount" class="form-control"
                           value="@Model.TotalAmount" min="0" step="0.01" required />
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check-lg me-1"></i> Save Changes
            </button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
        </div>

    </form>
</div>
