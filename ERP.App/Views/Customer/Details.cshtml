@using ERP.Services.ViewModels.CustomerVM
@using ERP.Services.ViewModels.OrderVM
@using ERP.Domain.Enums
@model CustomerDetailsViewModel

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container py-4">

    <!-- Header with breadcrumb -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-person-badge me-2 text-primary"></i>Customer Details
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Customer" asp-action="Index">Customers</a></li>
                <li class="breadcrumb-item active">Details</li>
            </ol>
        </nav>
    </div>

    <!-- Main card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <!-- Customer Information Section -->
            <h4 class="fw-bold text-dark mb-3">
                <i class="bi bi-person-circle me-2 text-primary"></i>Customer Information
            </h4>

            <dl class="row mb-4">
                <dt class="col-sm-3 text-muted fw-semibold">Name</dt>
                <dd class="col-sm-9 fw-bold">@Model.Name</dd>

                <dt class="col-sm-3 text-muted fw-semibold">Email</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3 text-muted fw-semibold">Phone</dt>
                <dd class="col-sm-9">@Model.Phone</dd>

                <dt class="col-sm-3 text-muted fw-semibold">Address</dt>
                <dd class="col-sm-9">@Model.Address</dd>
            </dl>

            <hr class="my-4" />

            <!-- Orders Section -->
            <h4 class="fw-bold text-dark mb-3">
                <i class="bi bi-cart3 me-2 text-primary"></i>Orders
            </h4>

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-0">
                    @if (!Model.Orders.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                            <p class="mb-0">No orders found for this customer.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Date</th>
                                        <th>Total Amount</th>
                                        <th>Remaining Amount</th>
                                        <th>Status</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.Orders)
                                    {
                                        <tr>
                                            <td>
                                                <code class="text-primary fw-medium">@order.Id</code>
                                            </td>
                                            <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                                            <td class="fw-semibold">@order.TotalAmount.ToString("C")</td>
                                            <td class="text-danger">@order.RemainingAmount.ToString("C")</td>
                                            <td>
                                                <span class="badge @(order.Status switch {
                                                    OrderStatus.Pending => "bg-warning text-dark",
                                                    OrderStatus.Completed => "bg-success",
                                                    OrderStatus.Cancelled => "bg-danger",
                                                    _ => "bg-secondary"
                                                })">
                                                    @order.Status
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id"
                                                   class="btn btn-sm btn-outline-secondary" title="View Order">
                                                    <i class="bi bi-eye-fill"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Payments Section -->
            <h4 class="fw-bold text-dark mb-3">
                <i class="bi bi-credit-card me-2 text-primary"></i>Payments
            </h4>

            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    @if (!Model.Payments.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                            <p class="mb-0">No payments recorded.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Payment ID</th>
                                        <th>Amount</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var payment in Model.Payments)
                                    {
                                        <tr>
                                            <td><code>@payment.Id</code></td>
                                            <td class="fw-semibold text-success">@payment.Amount.ToString("C")</td>
                                            <td>@payment.PaymentDate.ToString("dd MMM yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Action Buttons Footer -->
        <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0 d-flex gap-2">
            <a asp-controller="Customer" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Edit Customer
            </a>
            <a asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>
</div>