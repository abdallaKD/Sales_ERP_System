@model List<ERP.Services.ViewModels.UserViewModel>
@{
    ViewData["Title"] = "Users";

    int currentPage = Convert.ToInt32(ViewData["CurrentPage"] ?? 1);
    int totalPages = Convert.ToInt32(ViewData["TotalPages"] ?? 1);
    int pageSize = Convert.ToInt32(ViewData["PageSize"] ?? 10);
    string currentFilter = ViewData["CurrentFilter"] as string ?? string.Empty;

    int counter = ((currentPage - 1) * pageSize) + 1;

    var filtered = string.IsNullOrEmpty(currentFilter)
        ? Model
        : Model.Where(u =>
            u.FullName.Contains(currentFilter, StringComparison.OrdinalIgnoreCase) ||
            u.Email.Contains(currentFilter, StringComparison.OrdinalIgnoreCase))
          .ToList();
}

<div class="container-fluid px-4 py-3">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">

        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-people-fill me-2 text-primary"></i>Users
            </h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Users</li>
                </ol>
            </nav>
        </div>

        <div class="d-flex gap-2 flex-wrap flex-md-nowrap align-items-center">

            <!-- Search -->
            <form method="get" class="d-flex border rounded bg-white p-1 shadow-sm">
                <input type="text"
                       name="searchString"
                       value="@currentFilter"
                       class="form-control border-0 bg-transparent form-control-sm me-2"
                       style="min-width:220px;"
                       placeholder="Search by name or email..." />
                @if (!string.IsNullOrEmpty(currentFilter))
                {
                    <a asp-action="Users" class="btn btn-sm btn-light border-0 me-1">
                        <i class="bi bi-x-lg text-muted"></i>
                    </a>
                }
                <button type="submit" class="btn btn-sm btn-primary px-3">
                    <i class="bi bi-search"></i>
                </button>
            </form>

            <a asp-action="CreateUser" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add User
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (!filtered.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                    <p class="mb-0">
                        No users found. @(string.IsNullOrEmpty(currentFilter) ? "Add one now." : "Try adjusting your search.")
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Full Name</th>
                                <th>Email</th>
                                <th>Job Title</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in filtered)
                            {
                                <tr>
                                    <td class="text-muted">@(counter++)</td>
                                    <td class="fw-semibold">@user.FullName</td>
                                    <td class="text-muted">@user.Email</td>
                                    <td>@(user.JobTitle ?? "—")</td>
                                    <td>
                                        <span class="badge bg-secondary">@user.Role</span>
                                    </td>
                                    <td>
                                        <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                            @(user.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td class="text-center">

                                        <!-- Edit -->
                                        <a asp-action="EditUser" asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary me-1"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <!-- Change Password -->
                                        <a asp-action="changePassword" asp-route-userId="@user.Id"
                                           class="btn btn-sm btn-outline-warning me-1"
                                           title="Change Password">
                                            <i class="bi bi-key"></i>
                                        </a>

                                        <!-- Toggle Active -->
                                        <form asp-action="ToggleActive" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm me-1 @(user.IsActive ? "btn-outline-secondary" : "btn-outline-success")"
                                                    title="@(user.IsActive ? "Deactivate" : "Activate")">
                                                <i class="bi @(user.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                            </button>
                                        </form>

                                        <!-- Delete -->
                                        <form asp-action="DeleteUser" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this user permanently?')">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center py-3">
                        <div class="text-muted small">
                            Showing page <strong>@currentPage</strong> of @totalPages
                        </div>
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Users"
                                       asp-route-pageNumber="@(currentPage - 1)"
                                       asp-route-searchString="@currentFilter">
                                        Previous
                                    </a>
                                </li>
                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="Users"
                                           asp-route-pageNumber="@i"
                                           asp-route-searchString="@currentFilter">
                                            @i
                                        </a>
                                    </li>
                                }
                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link"
                                       asp-action="Users"
                                       asp-route-pageNumber="@(currentPage + 1)"
                                       asp-route-searchString="@currentFilter">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            }

        </div>
    </div>
</div>