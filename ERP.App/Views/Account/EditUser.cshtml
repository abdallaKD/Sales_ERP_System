@model ERP.Services.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="container-fluid px-4 py-3">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="mb-1 fw-bold text-dark">
            <i class="bi bi-person-gear me-2 text-primary"></i>Edit User
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Users">Users</a></li>
                <li class="breadcrumb-item active">Edit</li>
            </ol>
        </nav>
    </div>

    <!-- Validation Summary -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Please correct the following errors:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Form Card -->
    <div class="card border-0 shadow-sm" style="max-width:620px">
        <div class="card-body p-4">

            <form asp-action="EditUser" method="post">
                <input type="hidden" asp-for="Id" />

                <!-- Personal Info -->
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-person me-2 text-primary"></i>Personal Information
                </h5>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold"></label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. John Smith" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="JobTitle" class="form-label fw-semibold"></label>
                    <input asp-for="JobTitle" class="form-control" placeholder="e.g. Sales Manager" />
                </div>

                <hr class="my-4" />

                <!-- Account Info -->
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-envelope me-2 text-primary"></i>Account Information
                </h5>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <!-- Role & Status -->
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-person-badge me-2 text-primary"></i>Role & Status
                </h5>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold"></label>
                    <select asp-for="Role" class="form-select"
                            asp-items="@(new SelectList(Model.AvailableRoles))">
                        <option value="">— Select Role —</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label fw-semibold">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </label>
                    </div>
                    <small class="text-muted">Inactive users cannot log in to the system.</small>
                </div>

                <!-- Actions -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                    <a asp-action="Users" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i>Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}