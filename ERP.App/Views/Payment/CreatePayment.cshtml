@model ERP.Services.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Add Payment";
}

<h4 class="mb-4">Add Payment — Order #@Model.OrderId</h4>

<div class="row">
    <div class="col-md-5">

        <div class="card mb-3 border-0 bg-light">
            <div class="card-body">
                <div class="mb-2">
                    <span class="text-muted small">Customer</span>
                    <div class="fw-semibold">@Model.CustomerName</div>
                </div>
                <div class="row">
                    <div class="col">
                        <span class="text-muted small">Total</span>
                        <div class="fw-semibold">@Model.TotalAmount.ToString("C")</div>
                    </div>
                    <div class="col">
                        <span class="text-muted small">Paid</span>
                        <div class="fw-semibold text-success">@Model.PaidAmount.ToString("C")</div>
                    </div>
                    <div class="col">
                        <span class="text-muted small">Remaining</span>
                        <div class="fw-semibold text-danger">@Model.RemainingAmount.ToString("C")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="CreatePayment" method="post">
                    <input type="hidden" asp-for="OrderId" />
                    <input type="hidden" asp-for="CustomerName" />
                    <input type="hidden" asp-for="TotalAmount" />
                    <input type="hidden" asp-for="PaidAmount" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <input asp-for="Amount" class="form-control" placeholder="0.00" />
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaymentMethod" class="form-label"></label>
                        <select asp-for="PaymentMethod" class="form-select"
                                asp-items="Html.GetEnumSelectList<ERP.Domain.Enums.PaymentMethod>()">
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaymentDate" class="form-label"></label>
                        <input asp-for="PaymentDate" type="datetime-local" class="form-control" />
                        <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Payment</button>
                        <a asp-action="OrderPayments" asp-route-orderId="@Model.OrderId"
                           class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>