@model ERP.Services.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Add Payment";
}

<div class="container py-4" style="max-width: 700px;">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="mb-1 fw-bold text-dark">
            <i class="bi bi-cash me-2 text-primary"></i>Add Payment — Order #@Model.OrderId
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index">Orders</a></li>
                <li class="breadcrumb-item"><a asp-controller="Payment" asp-action="OrderPayments" asp-route-orderId="@Model.OrderId">Order #@Model.OrderId</a></li>
                <li class="breadcrumb-item active">Add Payment</li>
            </ol>
        </nav>
    </div>

    <!-- Validation Summary -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Please correct the following errors:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm" style="max-width:620px">
        <div class="card-body p-4">

            <!-- Order Summary -->
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-info-circle me-2 text-primary"></i>Order Summary
            </h5>

            <div class="row g-3 mb-4">
                <div class="col-12">
                    <div class="card border-0 bg-light rounded-3 p-3">
                        <div class="text-muted small mb-1">Customer</div>
                        <div class="fw-semibold text-dark">@Model.CustomerName</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card border-0 bg-light rounded-3 p-3 text-center">
                        <div class="text-muted small mb-1">Total</div>
                        <div class="fw-bold text-dark">@Model.TotalAmount.ToString("C")</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card border-0 bg-light rounded-3 p-3 text-center">
                        <div class="text-muted small mb-1">Paid</div>
                        <div class="fw-bold text-success">@Model.PaidAmount.ToString("C")</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card border-0 bg-light rounded-3 p-3 text-center">
                        <div class="text-muted small mb-1">Remaining</div>
                        <div class="fw-bold text-danger">@Model.RemainingAmount.ToString("C")</div>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <!-- Payment Form -->
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-credit-card me-2 text-primary"></i>Payment Details
            </h5>

            <form asp-action="CreatePayment" method="post">
                <input type="hidden" asp-for="OrderId" />
                <input type="hidden" asp-for="CustomerName" />
                <input type="hidden" asp-for="TotalAmount" />
                <input type="hidden" asp-for="PaidAmount" />

                <div class="mb-3">
                    <label asp-for="Amount" class="form-label fw-semibold"></label>
                    <input asp-for="Amount" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PaymentMethod" class="form-label fw-semibold"></label>
                    <select asp-for="PaymentMethod" class="form-select"
                            asp-items="Html.GetEnumSelectList<ERP.Domain.Enums.PaymentMethod>()">
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="PaymentDate" class="form-label fw-semibold"></label>
                    <input asp-for="PaymentDate" type="datetime-local" class="form-control" />
                    <span asp-validation-for="PaymentDate" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Save Payment
                    </button>
                    <a asp-action="OrderPayments" asp-route-orderId="@Model.OrderId"
                       class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i>Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}