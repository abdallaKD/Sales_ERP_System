@model List<ERP.Services.ViewModels.PaymentListViewModel>
@{
    ViewData["Title"] = $"Payments for Order #{ViewBag.OrderId}";
    int counter = 1;
}

<div class="container-fluid px-4 py-3">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="mb-1 fw-bold text-dark">
                <i class="bi bi-cash-stack me-2 text-primary"></i>Payments — Order #@ViewBag.OrderId
            </h2>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index">Orders</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Payment" asp-action="Index">Payments</a></li>
                    <li class="breadcrumb-item active">Order #@ViewBag.OrderId</li>
                </ol>
            </nav>
        </div>

        <a asp-action="CreatePayment" asp-route-orderId="@ViewBag.OrderId"
           class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Payment
        </a>
    </div>

    <!-- Summary Cards -->
    @{
        var status = Model.FirstOrDefault()?.PaymentStatus;

        var badgeClass = status == "Paid" ? "bg-success"
        : status == "Partial" ? "bg-warning text-dark"
        : "bg-danger";
    }

    @if (Model.Any())
    {
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-3">
                        <div class="text-muted small mb-1">Total</div>
                        <div class="fw-bold fs-5 text-dark">
                            @Model.First().OrderTotal.ToString("C")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-3">
                        <div class="text-muted small mb-1">Paid</div>
                        <div class="fw-bold fs-5 text-success">
                            @Model.First().OrderPaid.ToString("C")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-3">
                        <div class="text-muted small mb-1">Remaining</div>
                        <div class="fw-bold fs-5 text-danger">
                            @Model.First().OrderRemaining.ToString("C")
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center py-3">
                        <div class="text-muted small mb-1">Status</div>
                        <span class="badge @badgeClass fs-6 mt-1">
                            @status
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Alerts -->
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>@success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                    <p class="mb-0">No payments recorded for this order yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Date</th>
                                @if (User.IsInRole("Admin"))
                                {
                                    <th class="text-center">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td class="text-muted">@(counter++)</td>
                                    <td class="text-success fw-semibold">@p.Amount.ToString("C")</td>
                                    <td>@p.PaymentMethod</td>
                                    <td>@p.PaymentDate.ToString("dd MMM yyyy")</td>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <td class="text-center">
                                            <form asp-action="DeletePayment" method="post" class="d-inline"
                                                  onsubmit="return confirm('Delete this payment? The order balance will be reversed.')">
                                                <input type="hidden" name="id" value="@p.Id" />
                                                <input type="hidden" name="orderId" value="@p.OrderId" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>

    <!-- Back Button -->
    <div class="mt-3">
        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Orders
        </a>
    </div>

</div>